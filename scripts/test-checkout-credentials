#!/usr/bin/env bash
set -euo pipefail

ZIZMOR_VERSION="${ZIZMOR_VERSION:-1.28.0}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "${fixture_root}"' EXIT

write_workflow() {
  local fixture="$1"
  local contents="$2"
  mkdir -p "${fixture_root}/${fixture}/.github/workflows"
  printf '%s\n' "${contents}" > "${fixture_root}/${fixture}/.github/workflows/test.yml"
}

run_audit() {
  local fixture="$1"
  local report="${fixture_root}/${fixture}.json"
  uvx --from "zizmor==${ZIZMOR_VERSION}" zizmor \
    --offline \
    --strict-collection \
    --collect=workflows,actions \
    --no-config \
    --no-ignores \
    --no-exit-codes \
    --format=json-v1 \
    "${fixture_root}/${fixture}" > "${report}"
}

assert_artipacked_count() {
  local fixture="$1"
  local expected="$2"
  local report="${fixture_root}/${fixture}.json"
  local actual
  actual="$(jq '[.[] | select(.ident == "artipacked" and .ignored == false)] | length' "${report}")"
  if [ "${actual}" -ne "${expected}" ]; then
    echo "${fixture}: expected ${expected} artipacked finding(s), got ${actual}" >&2
    jq '.' "${report}" >&2
    exit 1
  fi
}

write_workflow safe 'name: safe
on: push
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false'
run_audit safe
assert_artipacked_count safe 0

write_workflow omitted 'name: omitted
on: push
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4'
run_audit omitted
assert_artipacked_count omitted 1

write_workflow explicit-true 'name: explicit-true
on: push
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true'
run_audit explicit-true
assert_artipacked_count explicit-true 0

mkdir -p "${fixture_root}/composite/.github/actions/unsafe"
printf '%s\n' 'name: unsafe composite
description: fixture
runs:
  using: composite
  steps:
    - uses: actions/checkout@v4' > "${fixture_root}/composite/.github/actions/unsafe/action.yml"
run_audit composite
assert_artipacked_count composite 1

write_workflow malformed 'name: malformed
on: push
jobs:
  test:
    runs-on: ['
if run_audit malformed; then
  echo "malformed: strict collection unexpectedly succeeded" >&2
  exit 1
fi

# The PR gate must be loaded from the trusted base branch. The reusable
# workflow then skips checkout and reads only changed YAML through GitHub's API.
caller="${repo_root}/.github/workflows/checkout-credentials-caller.yml"
reusable="${repo_root}/.github/workflows/checkout-credentials.yml"
grep -Eq '^  pull_request_target:$' "${caller}"
if grep -Eq '^  pull_request:$' "${caller}"; then
  echo "caller: pull_request would let a PR replace its own security gate" >&2
  exit 1
fi
if grep -Eq '^    paths(-ignore)?:$' "${caller}"; then
  echo "caller: path filters can skip the security gate on oversized diffs" >&2
  exit 1
fi
grep -Eq '^        if: inputs\.pull_request_number == 0$' "${reusable}"
grep -Eq 'pulls/\$\{PULL_REQUEST_NUMBER\}/files' "${reusable}"
grep -Eq 'contents_url' "${reusable}"

echo "checkout credential fixtures passed"
