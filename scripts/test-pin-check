      contents: read
      actions: read
    uses: ${lint_pin}"
expect_pass job-id-yes

# Job ids that safe_load folds together (yes, on, true) are distinct jobs to
# GitHub; each is checked against its own grant.
write_file folded-ids .github/workflows/test.yml "name: test
on: pull_request
jobs:
  yes:
    permissions: {}
    uses: ${lint_pin}
  on:
    permissions:
      contents: read
      actions: read
    uses: ${lint_pin}"
expect_fail folded-ids "job 'yes' grants actions: none, but ${lint_ref} asks for actions: read"

write_file repeated-id .github/workflows/test.yml "name: test
on: pull_request
jobs:
  lint:
    permissions:
      contents: read
    uses: ${lint_pin}
  lint:
    permissions: write-all
    uses: ${lint_pin}"
expect_fail repeated-id "job 'lint' grants actions: none, but ${lint_ref} asks for actions: read"

