#!/usr/bin/env bash
# Tests for .github/workflows/pin-check.yml.
#
# Each step under test is extracted from the workflow and run the way the
# runner runs it. Stand-in `git` and `gh` executables, first on PATH, serve
# fixture tag listings and API responses, so the shipped lookup code runs,
# failure paths included. The last cases go online (git ls-remote against
# github.com); set PIN_CHECK_OFFLINE=1 to skip them.
set -euo pipefail

PYYAML="pyyaml==6.0.3"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workflow="${repo_root}/.github/workflows/pin-check.yml"
caller="${repo_root}/.github/workflows/pin-check-caller.yml"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

failures=0
fail() {
  echo "FAIL: $*" >&2
  failures=$((failures + 1))
}

# The workflow runs the check with `uv run --with pyyaml`, which puts its
# interpreter's directory first on PATH; on a runner that directory also holds
# git and gh and would shadow the stand-ins below. The tests therefore run the
# extracted script with a venv's interpreter called directly, which leaves
# PATH alone. The shell line itself is asserted below.
uv venv --no-config --quiet "${work}/venv"
uv pip install --no-config --quiet --python "${work}/venv/bin/python" "${PYYAML}"
python="${work}/venv/bin/python"

# --- the three steps, exactly as the workflow carries them
"${python}" - "${workflow}" "${work}" "${PYYAML}" <<'PY'
import sys

import yaml

workflow, out, pyyaml = sys.argv[1:4]
with open(workflow) as handle:
    job = yaml.safe_load(handle)["jobs"]["pins"]
assert "continue-on-error" not in job and "if" not in job, "the pins job must not fail open"
steps = job["steps"]
wanted = {
    "Prepare audit target": ("prepare.sh", "bash"),
    "Require full-SHA pins": ("full-sha.sh", "bash"),
    "Check version comments and reusable-workflow permissions":
        ("check.py", f"uv run --no-config --no-project --with {pyyaml} python3 {{0}}"),
}
for step in steps:
    if step.get("name") in wanted:
        filename, shell = wanted.pop(step["name"])
        assert step.get("shell") == shell, (step["name"], step.get("shell"))
        # A step that may fail, or may not run, would switch the gate off.
        assert "continue-on-error" not in step and "if" not in step, step["name"]
        with open(f"{out}/{filename}", "w") as handle:
            handle.write(step["run"])
assert not wanted, f"steps not found in the workflow: {sorted(wanted)}"
PY

# --- stand-ins for git ls-remote and the GitHub API
fakebin="${work}/bin"
export FAKE_GIT_DIR="${work}/git" FAKE_GH_DIR="${work}/gh"
mkdir -p "${fakebin}" "${FAKE_GIT_DIR}/acme" "${FAKE_GH_DIR}"
cat > "${fakebin}/git" <<'PY'
#!/usr/bin/env python3
import os, re, sys
args = sys.argv[1:]
if args[:2] != ["ls-remote", "--tags"] or len(args) != 3:
    sys.exit(f"stand-in git: unsupported call {args}")
match = re.fullmatch(r"https://github\.com/([^/]+)/([^/]+)\.git", args[2])
if not match:
    sys.exit(f"stand-in git: unexpected URL {args[2]}")
path = os.path.join(os.environ["FAKE_GIT_DIR"], match[1], match[2] + ".tags")
if os.path.isfile(path[:-5] + ".stderr"):
    sys.stderr.write(open(path[:-5] + ".stderr").read())
    sys.exit(128)
if not os.path.isfile(path):
    sys.stderr.write("fatal: could not read Username for 'https://github.com': terminal prompts disabled\n")
    sys.exit(128)
sys.stdout.write(open(path).read())
PY
cat > "${fakebin}/gh" <<'PY'
#!/usr/bin/env python3
import os, re, subprocess, sys
args = sys.argv[1:]
if not args or args[0] != "api":
    sys.exit(f"stand-in gh: unsupported call {args}")
import hashlib, json
endpoint, jq, paginate, rest = None, None, False, args[1:]
while rest:
    arg = rest.pop(0)
    if arg == "--paginate":
        paginate = True
    elif arg == "--jq":
        jq = rest.pop(0)
    elif arg.startswith("-"):
        sys.exit(f"stand-in gh: unsupported flag {arg}")
    else:
        endpoint = arg
# Responses are keyed by the exact endpoint, less the API host, so a request
# with a different path or query finds nothing.
key = hashlib.sha256(re.sub(r"^https://api\.github\.com/", "", endpoint).encode()).hexdigest()
path = os.path.join(os.environ["FAKE_GH_DIR"], key)
if not os.path.isfile(path):
    sys.stderr.write("gh: Not Found (HTTP 404)\n")
    sys.exit(1)
pages = json.load(open(path))
if not paginate:
    pages = pages[:1]  # without --paginate, gh returns the first page only
status = 0
for body in pages:
    if jq is None:
        sys.stdout.write(body)
        continue
    result = subprocess.run(["jq", "-r", jq], input=body, text=True, capture_output=True)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    status = status or result.returncode
sys.exit(status)
PY
chmod +x "${fakebin}/git" "${fakebin}/gh"

# gh_response ENDPOINT BODY [BODY ...]: what the stand-in gh returns for
# exactly ENDPOINT, one body per page
gh_response() {
  local endpoint="$1"
  shift
  "${python}" -c 'import hashlib, json, sys
key = hashlib.sha256(sys.argv[2].encode()).hexdigest()
json.dump(sys.argv[3:], open(f"{sys.argv[1]}/{key}", "w"))' "${FAKE_GH_DIR}" "${endpoint}" "$@"
}

# contents_response REPOSITORY PATH REF TEXT: a contents-API file
contents_response() {
  local content
  content="$(printf '%s\n' "$4" | base64 | tr -d '\n')"
  gh_response "repos/$1/contents/$2?ref=$3" "{\"type\":\"file\",\"encoding\":\"base64\",\"content\":\"${content}\"}"
}

A=1111111111111111111111111111111111111111   # v1.2.0
TEN=7777777777777777777777777777777777777777 # v10.0.0, not in the v1 line
RC=8888888888888888888888888888888888888888  # v1.0.0-rc.1 only, a pre-release
B=2222222222222222222222222222222222222222   # v1.3.0, and the alias v1
C=3333333333333333333333333333333333333333   # no tag points here
T=4444444444444444444444444444444444444444   # annotated tag object of v2.0.0
D=5555555555555555555555555555555555555555   # the commit v2.0.0 points at
E=abcdefabcdefabcdefabcdefabcdefabcdefabcd   # v3.0.0
E_UPPER=ABCDEFABCDEFABCDEFABCDEFABCDEFABCDEFABCD
H=6666666666666666666666666666666666666666   # head of the stand-in pull requests
for repository in tool wf; do
  printf '%s\trefs/tags/%s\n' \
    "${A}" v1.2.0 "${B}" v1.3.0 "${B}" v1 "${T}" v2.0.0 "${D}" 'v2.0.0^{}' "${E}" v3.0.0 "${TEN}" v10.0.0 "${RC}" v1.0.0-rc.1 \
    > "${FAKE_GIT_DIR}/acme/${repository}.tags"
done
printf 'zzzz\trefs/tags/v9.9.9\n' >> "${FAKE_GIT_DIR}/acme/tool.tags"

# write_file FIXTURE PATH CONTENTS
write_file() {
  mkdir -p "$(dirname "${work}/fixtures/$1/$2")"
  printf '%s\n' "$3" > "${work}/fixtures/$1/$2"
}

# step_workflow FIXTURE USES: a one-step workflow
step_workflow() {
  write_file "$1" .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: $2"
}

# run_check FIXTURE [VAR=VALUE ...]: the version-comment and permission step
run_check() {
  local fixture="$1"
  shift
  env AUDIT_TARGET="${work}/fixtures/${fixture}" PATH="${fakebin}:${PATH}" "$@" \
    "${python}" "${work}/check.py" > "${work}/${fixture}.out" 2>&1
}

# The runner reads a line as a workflow command when, after leading
# whitespace, it starts with `::`, or when it holds `##[` anywhere; between
# `::stop-commands::TOKEN` and `::TOKEN::` it reads none.
cat > "${work}/commands.py" <<'DETECT'
import re, sys
registered = {"add-mask", "add-matcher", "remove-matcher", "add-path", "set-env", "set-output", "save-state",
              "debug", "notice", "warning", "error", "group", "endgroup", "echo", "stop-commands"}
own = re.compile(r"^::error (file=[^:]*,line=[0-9]+,)?title=pin-check( unpinned)?::")
def parse(line):
    trimmed = line.lstrip()
    if trimmed.startswith("::") and (end := trimmed.find("::", 2)) >= 0:
        name = trimmed[2:end].split(" ", 1)[0]
        if name.lower() in registered:
            return "v2", name, trimmed[end + 2:]
    if (start := line.find("##[")) >= 0 and (close := line.find("]", start)) >= 0:
        name = line[start + 3:close].split(" ", 1)[0]
        if name.lower() in registered:
            return "v1", name, line[close + 1:]
    return None
stopped, forged = None, []
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
for number, line in enumerate(re.split(r"\r\n|\r|\n", text), 1):
    command = parse(line)
    if command is None:
        continue
    kind, name, payload = command
    if stopped is not None:
        if name.lower() == stopped.lower():
            stopped = None
        continue
    if kind == "v2" and name.lower() == "stop-commands" and re.fullmatch(r"[0-9a-f]{32}", payload):
        stopped = payload
        registered.add(payload.lower())
        continue
    if not (kind == "v2" and own.match(line.lstrip())):
        forged.append(f"{number}: {line[:160]}")
print("\n".join(forged))
sys.exit(1 if forged else 0)
DETECT

# no_forged_commands FILE: every workflow command the runner would read in FILE is one this check wrote
no_forged_commands() {
  if ! "${python}" "${work}/commands.py" "$1" > "$1.commands"; then
    fail "$1: output carries a workflow command the check did not write"
    sed 's/^/    /' "$1.commands" >&2
  fi
}

expect_pass() {
  local fixture="$1"
  shift
  if ! run_check "${fixture}" "$@"; then
    fail "${fixture}: expected the check to pass"
    sed 's/^/    /' "${work}/${fixture}.out" >&2
  fi
  no_forged_commands "${work}/${fixture}.out"
}

# expect_fail FIXTURE TEXT [VAR=VALUE ...]: fails, and an annotation contains TEXT
expect_fail() {
  local fixture="$1" text="$2"
  shift 2
  if run_check "${fixture}" "$@"; then
    fail "${fixture}: expected the check to fail"
  elif ! grep -F -- '::error ' "${work}/${fixture}.out" | grep -Fq -- "${text}"; then
    fail "${fixture}: no annotation contains: ${text}"
    sed 's/^/    /' "${work}/${fixture}.out" >&2
  fi
  no_forged_commands "${work}/${fixture}.out"
}

# expect_also FIXTURE TEXT: the last run of FIXTURE also carries an annotation with TEXT
expect_also() {
  if ! grep -F -- '::error ' "${work}/$1.out" | grep -Fq -- "$2"; then
    fail "$1: no annotation contains: $2"
  fi
}

# --- version comments
step_workflow exact "acme/tool@${A} # v1.2.0"
expect_pass exact

step_workflow alias-moved "acme/tool@${A} # v1"
expect_pass alias-moved

step_workflow stale-comment "acme/tool@${A} # v1.3.0"
expect_fail stale-comment "tag v1.3.0 of acme/tool is at 222222222222, not 111111111111; 111111111111 is tagged v1.2.0"

step_workflow no-comment "acme/tool@${A}"
expect_fail no-comment "has no version comment"

step_workflow unknown-tag "acme/tool@${A} # v9"
expect_fail unknown-tag "the comment names v9, which is not a tag of acme/tool; 111111111111 is tagged v1.2.0"

step_workflow untagged "acme/tool@${C} # v1.2.0"
expect_fail untagged "no tag of acme/tool points at 333333333333"

step_workflow annotated "acme/tool@${D} # v2.0.0"
expect_pass annotated

step_workflow annotated-object "acme/tool@${T} # v2.0.0"
expect_fail annotated-object "tag v2.0.0 of acme/tool is at 555555555555, not 444444444444"

step_workflow quoted "'acme/tool@${A}' # v1.2.0"
expect_pass quoted

step_workflow upper-case-sha "acme/tool@${E_UPPER} # v3.0.0"
expect_pass upper-case-sha

step_workflow alias-other-line "acme/tool@${TEN} # v1"
expect_fail alias-other-line "tag v1 of acme/tool is at 222222222222, not 777777777777; 777777777777 is tagged v10.0.0"

step_workflow alias-pre-release "acme/tool@${RC} # v1"
expect_fail alias-pre-release "tag v1 of acme/tool is at 222222222222, not 888888888888; 888888888888 is tagged v1.0.0-rc.1"

step_workflow malformed-tag-row "acme/tool@${A} # v9.9.9"
expect_fail malformed-tag-row "the comment names v9.9.9, which is not a tag of acme/tool"

# An anchor may stand before the key on the step line too (it anchors the key).
write_file anchor-before-key .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  a:
    runs-on: ubuntu-latest
    steps:
      - &tool uses: acme/tool@${A} # v1.2.0"
expect_pass anchor-before-key

write_file set-step .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - !!set {uses: acme/tool@main}"
expect_fail set-step "is not a plain mapping"

# A .git directory is never read.
write_file dot-git .git/x/action.yml "name: x
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@v1"
write_file dot-git .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${A} # v1.2.0"
expect_pass dot-git

# A linked workflow or action file loads whatever it points at, which can
# change without touching the link.
write_file symlink ci/x-action.yaml "name: x
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@${A} # v1.2.0"
mkdir -p "${work}/fixtures/symlink/tools/x"
ln -s ../../ci/x-action.yaml "${work}/fixtures/symlink/tools/x/action.yml"
expect_fail symlink "tools/x/action.yml,line=1,title=pin-check::is a symbolic link"

# File names are annotation properties: line breaks are escaped.
write_file lf-name $'.github/workflows/a\nb.yml' "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@v1"
expect_fail lf-name "::error file=.github/workflows/a%0Ab.yml,line=8,title=pin-check::acme/tool@v1 is not pinned"
write_file cr-name $'.github/workflows/a\rb.yml' "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@v1"
expect_fail cr-name "::error file=.github/workflows/a%0Db.yml,line=8,title=pin-check::acme/tool@v1 is not pinned"

step_workflow upper-case-wrong "acme/tool@${E_UPPER} # v1.2.0"
expect_fail upper-case-wrong "tag v1.2.0 of acme/tool is at 111111111111, not abcdefabcdef; abcdefabcdef is tagged v3.0.0"

# An image needs a tag or a digest.
for case in "docker-untagged-check:docker://alpine" "docker-registry-port:docker://localhost:5000/img" \
    "docker-short-digest:docker://alpine@sha256:abc"; do
  step_workflow "${case%%:*}" "${case#*:}"
  expect_fail "${case%%:*}" "${case#*:} names no image tag or digest"
done

# Merge keys are refused anywhere, not only where a uses could hide.
write_file merge-permissions .github/workflows/test.yml "name: test
on: pull_request
x-grant: &grant
  contents: read
  actions: read
jobs:
  lint:
    permissions:
      <<: *grant
    uses: acme/wf/.github/workflows/lint.yml@${A} # v1.2.0"
expect_fail merge-permissions "YAML merge keys are not supported (line 9)"

step_workflow docker-empty-tag "'docker://alpine:'"
expect_fail docker-empty-tag "docker://alpine: names no image tag or digest"

step_workflow docker-digest "docker://alpine@sha256:$(printf 'a%.0s' $(seq 1 64))"
expect_pass docker-digest

write_file dangling-link .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${A} # v1.2.0"
ln -s ../../nowhere.yml "${work}/fixtures/dangling-link/.github/workflows/linked.yml"
expect_fail dangling-link "file=.github/workflows/linked.yml,line=1,title=pin-check::is a symbolic link"

# Local and docker references are not pins; the check passes over them.
write_file not-pins .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: ./tools/setup
      - uses: docker://alpine:3.20
      - uses: acme/tool@${A} # v1.2.0"
expect_pass not-pins

# A lookup tool that cannot be started fails the check.
step_workflow no-git "acme/tool@${A} # v1.2.0"
expect_fail no-git "listing the tags of acme/tool failed: [Errno 2]" PATH=/nonexistent

step_workflow tag-pin "acme/tool@v1"
expect_fail tag-pin "acme/tool@v1 is not pinned to a full commit SHA"

# zizmor sees a hash pin here and stays silent, so this step must not skip it.
step_workflow unreadable-path "acme/tool/x+y@${C} # v1.2.0"
expect_fail unreadable-path "cannot read 'acme/tool/x+y@${C}' as owner/repo[/path]@ref"

step_workflow no-tag-listing "acme/missing@${A} # v1.2.0"
expect_fail no-tag-listing "listing the tags of acme/missing failed: fatal: could not read Username"

write_file composite actions/lint/action.yml "name: lint
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@${A} # v1.3.0"
expect_fail composite "tag v1.3.0 of acme/tool"

write_file node-modules tools/node_modules/setup/action.yml "name: setup
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@${C} # v1.2.0"
expect_fail node-modules "no tag of acme/tool points at 333333333333"

write_file dot-yml .github/workflows/.yml "name: test
on: push
permissions: {}
