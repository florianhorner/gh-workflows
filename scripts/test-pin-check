gh_response "repos/acme/repo/pulls/11/files?per_page=100" "[$(api_file 'tools/x\n##[warning file=README.md;line=1;title=pin-check]looks fine/action.yml')]"
gh_response "repos/acme/repo/pulls/9" "{\"changed_files\":1,\"head\":{\"sha\":\"${H}\"}}"
gh_response "repos/acme/repo/pulls/9/files?per_page=100" "[$(api_file '..\n::warning::forged/action.yml')]"

# run_prepare CASE PULL_REQUEST_NUMBER: 0 when the step passes
run_prepare() {
  local dir="${work}/prepare-$1"
  mkdir -p "${dir}/temp" "${dir}/workspace"
  : > "${dir}/env"
  local status=0
  GITHUB_ENV="${dir}/env" RUNNER_TEMP="${dir}/temp" GITHUB_WORKSPACE="${dir}/workspace" \
    GITHUB_REPOSITORY=acme/repo PULL_REQUEST_NUMBER="$2" PATH="${fakebin}:${PATH}" \
    bash --noprofile --norc -eo pipefail "${work}/prepare.sh" > "${dir}/out" 2>&1 || status=$?
  no_forged_commands "${dir}/out"
  return "${status}"
}
# run_pipeline CASE PULL_REQUEST_NUMBER: the collection step, then the two
# checks with the variables it wrote to GITHUB_ENV; 0 when all three pass
run_pipeline() {
  local dir="${work}/prepare-$1" status=0
  run_prepare "$1" "$2" || return 1
  (
    set -a
    # shellcheck disable=SC1090,SC1091
    . "${dir}/env"
    set +a
    RUNNER_TEMP="${dir}/temp" bash --noprofile --norc -eo pipefail "${work}/full-sha.sh" > "${dir}/full-sha.out" 2>&1 \
      && PATH="${fakebin}:${PATH}" GITHUB_REPOSITORY=acme/repo "${python}" "${work}/check.py" > "${dir}/check.out" 2>&1
  ) || status=1
  no_forged_commands "${dir}/full-sha.out"
  [ ! -f "${dir}/check.out" ] || no_forged_commands "${dir}/check.out"
  return "${status}"
}
if run_pipeline empty 12; then
  grep -Fxq "AUDIT_TARGET_EMPTY=true" "${work}/prepare-empty/env" || fail "prepare empty: AUDIT_TARGET_EMPTY is not true"
  grep -Fxq "PIN_CHECK_COLLECTED=0" "${work}/prepare-empty/env" || fail "prepare empty: collected count"
else
  fail "prepare empty: a pull request with no workflow YAML failed"
fi
if run_prepare dot-segment 13; then
  fail "prepare dot-segment: '../escape/action.yml' was accepted"
elif ! grep -Fq "Unsafe workflow path returned by GitHub (base64)" "${work}/prepare-dot-segment/out"; then
  fail "prepare dot-segment: unexpected output"
fi
if run_pipeline pipeline 7; then
  fail "prepare pipeline: the stale comment in the collected action passed"
elif ! grep -Fq "::error file=tools/setup/action.yml,line=6,title=pin-check::tag v1.3.0 of acme/tool" "${work}/prepare-pipeline/check.out"; then
  fail "prepare pipeline: unexpected output"
  sed 's/^/    /' "${work}/prepare-pipeline/"*.out >&2 || true
fi
if run_prepare pr 7; then
  grep -Fxq "AUDIT_TARGET=${work}/prepare-pr/temp/pin-check-audit" "${work}/prepare-pr/env" || fail "prepare pr: audit target"
  grep -Fxq "AUDIT_TARGET_EMPTY=false" "${work}/prepare-pr/env" || fail "prepare pr: AUDIT_TARGET_EMPTY is not false"
  [ ! -e "${work}/prepare-pr/temp/pin-check-audit/.github/workflows/old.yml" ] || fail "prepare pr: collected a removed file"
  grep -Fxq "PIN_CHECK_COLLECTED=2" "${work}/prepare-pr/env" || fail "prepare pr: collected count"
  grep -Fxq "PIN_CHECK_HEAD_SHA=${H}" "${work}/prepare-pr/env" || fail "prepare pr: head SHA"
  [ -f "${work}/prepare-pr/temp/pin-check-audit/tools/setup/action.yml" ] || fail "prepare pr: action outside .github not collected"
  [ ! -e "${work}/prepare-pr/temp/pin-check-audit/README.md" ] || fail "prepare pr: collected a file that is not workflow YAML"
  # The collected files, end to end: the action's comment is stale.
  if env AUDIT_TARGET="${work}/prepare-pr/temp/pin-check-audit" PIN_CHECK_COLLECTED=2 PATH="${fakebin}:${PATH}" \
      "${python}" "${work}/check.py" > "${work}/prepare-pr/check.out" 2>&1; then
    fail "prepare pr: the stale comment in the collected action passed"
  elif ! grep -Fq "::error file=tools/setup/action.yml,line=6,title=pin-check::tag v1.3.0 of acme/tool" "${work}/prepare-pr/check.out"; then
    fail "prepare pr: unexpected check output"
    sed 's/^/    /' "${work}/prepare-pr/check.out" >&2
  fi
  no_forged_commands "${work}/prepare-pr/check.out"
else
  fail "prepare pr: the collection step failed"
  sed 's/^/    /' "${work}/prepare-pr/out" >&2
fi
if run_prepare case 10; then
  grep -Fxq "PIN_CHECK_COLLECTED=2" "${work}/prepare-case/env" || fail "prepare case: Action.yml not collected"
  if env AUDIT_TARGET="${work}/prepare-case/temp/pin-check-audit" PIN_CHECK_COLLECTED=2 PATH="${fakebin}:${PATH}" \
      "${python}" "${work}/check.py" > "${work}/prepare-case/check.out" 2>&1; then
    fail "prepare case: the untagged pin in Action.yml passed"
  fi
  no_forged_commands "${work}/prepare-case/check.out"
else
  fail "prepare case: the collection step failed"
  sed 's/^/    /' "${work}/prepare-case/out" >&2
fi
if run_prepare partial 8; then
  fail "prepare partial: a short file list was accepted"
elif ! grep -Fq "refusing a partial audit" "${work}/prepare-partial/out"; then
  fail "prepare partial: unexpected output"
fi
if run_prepare unsafe 9; then
  fail "prepare unsafe: a dot-segment path was accepted"
else
  grep -Fq "Unsafe workflow path returned by GitHub (base64)" "${work}/prepare-unsafe/out" || fail "prepare unsafe: unexpected output"
fi
if run_prepare legacy 11; then
  fail "prepare legacy: a path with a line break was accepted"
fi
if run_prepare symlink 15; then
  fail "prepare symlink: a linked action file was accepted"
elif ! grep -Fq "Workflow or action files that are symbolic links (base64): $(printf 'tools/x/action.yml' | base64 -w0)" "${work}/prepare-symlink/out"; then
  fail "prepare symlink: unexpected output"
fi
if run_prepare truncated 16; then
  fail "prepare truncated: a truncated tree was accepted"
elif ! grep -Fq "too large to list in one response" "${work}/prepare-truncated/out"; then
  fail "prepare truncated: unexpected output"
fi
if run_pipeline dot-yml 17; then
  fail "prepare dot-yml: the untagged pin in .github/workflows/.yml passed"
else
  grep -Fxq "PIN_CHECK_COLLECTED=1" "${work}/prepare-dot-yml/env" || fail "prepare dot-yml: .yml not collected"
fi
for case in long:18 command:19; do
  if run_prepare "${case%%:*}-name" "${case##*:}"; then
    fail "prepare ${case%%:*}-name: an unsafe name was accepted"
  elif ! grep -Fq "Unsafe workflow path returned by GitHub (base64)" "${work}/prepare-${case%%:*}-name/out"; then
    fail "prepare ${case%%:*}-name: unexpected output"
  fi
done
if run_pipeline zizmor-skip 20; then
  grep -Fq "zizmor found no file it reads" "${work}/prepare-zizmor-skip/full-sha.out" || fail "prepare zizmor-skip: zizmor's verdict was not taken as a skip"
else
  fail "prepare zizmor-skip: a correctly pinned Action.yml alone failed"
  sed 's/^/    /' "${work}/prepare-zizmor-skip/"*.out >&2 || true
fi
if ! run_pipeline dot-yaml-ok 23; then
  fail "prepare dot-yaml-ok: a correctly pinned .github/workflows/.yaml alone failed"
  sed 's/^/    /' "${work}/prepare-dot-yaml-ok/"*.out >&2 || true
fi
if run_pipeline image-only 24; then
  fail "prepare image-only: an untagged image in an Action.yml passed"
elif ! grep -Fq "docker://alpine names no image tag or digest" "${work}/prepare-image-only/check.out"; then
  fail "prepare image-only: unexpected output"
fi
if run_prepare bad-head 21; then
  fail "prepare bad-head: a head that is not a SHA was accepted"
elif ! grep -Fq "Unexpected pull request head SHA (base64)" "${work}/prepare-bad-head/out"; then
  fail "prepare bad-head: unexpected output"
fi
if run_prepare not-a-file 22; then
  fail "prepare not-a-file: a contents entry that is not a file was accepted"
fi
if run_prepare push 0; then
  grep -Fxq "AUDIT_TARGET=${work}/prepare-push/workspace" "${work}/prepare-push/env" || fail "prepare push: audit target"
  grep -Fxq "AUDIT_TARGET_EMPTY=false" "${work}/prepare-push/env" || fail "prepare push: AUDIT_TARGET_EMPTY is not false"
  grep -Fxq "PIN_CHECK_COLLECTED=" "${work}/prepare-push/env" || fail "prepare push: a collected count is set"
else
  fail "prepare push: the step failed"
fi

# --- the gate's own shape
grep -Eq '^  pull_request_target:$' "${caller}" || fail "caller: must run on pull_request_target"
if grep -Eq '^  pull_request:$' "${caller}"; then
  fail "caller: pull_request would let a PR replace its own gate"
fi
if grep -Eq '^    paths(-ignore)?:$' "${caller}"; then
  fail "caller: path filters can skip the gate on oversized diffs"
fi
grep -Eq '^        if: inputs\.pull_request_number == 0$' "${workflow}" || fail "workflow: checkout must be push-only"
# A problem matcher reads a step's log even with workflow commands switched off.
grep -Eq '^          add-problem-matchers: false$' "${workflow}" || fail "workflow: setup-uv must not add problem matchers"
for flag in --offline --no-config --no-ignores --strict-collection; do
  grep -Eq -- "^            ${flag} \\\\$" "${workflow}" || fail "workflow: zizmor must run with ${flag}"
done

# --- online: this repository's own pins, and one real mismatch
if [ "${PIN_CHECK_OFFLINE:-0}" != 1 ]; then
  if ! AUDIT_TARGET="${repo_root}" "${python}" "${work}/check.py" > "${work}/self.out" 2>&1; then
    fail "self: this repository's pins do not pass"
    sed 's/^/    /' "${work}/self.out" >&2
  fi
  no_forged_commands "${work}/self.out"
  checkout_v4=11d5960a326750d5838078e36cf38b85af677262
  step_workflow real-mismatch "actions/checkout@${checkout_v4} # v3"
  if AUDIT_TARGET="${work}/fixtures/real-mismatch" "${python}" "${work}/check.py" \
      > "${work}/real-mismatch.out" 2>&1; then
    fail "real-mismatch: a v4 commit commented as v3 passed"
  elif ! grep -Fq "tag v3 of actions/checkout is at" "${work}/real-mismatch.out"; then
    fail "real-mismatch: unexpected output"
    sed 's/^/    /' "${work}/real-mismatch.out" >&2
  fi
  no_forged_commands "${work}/real-mismatch.out"
fi

if [ "${failures}" -ne 0 ]; then
  echo "${failures} pin-check test(s) failed" >&2
  exit 1
fi
echo "pin-check tests passed"
