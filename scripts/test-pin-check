  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${C} # v1.2.0"
expect_fail dot-yml "no tag of acme/tool points at 333333333333"

# A runner on a case-insensitive file system loads Action.yml as action.yml.
write_file action-case tools/setup/Action.yml "name: setup
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@${C} # v1.2.0"
expect_fail action-case "no tag of acme/tool points at 333333333333"

# YAML merge keys and tagged steps hide keys from a node walk; they are refused.
write_file merge-step .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        include:
          - &base {uses: acme/tool@${C}}
    steps:
      - <<: *base"
expect_fail merge-step "YAML merge keys are not supported"

write_file merge-jobs .github/workflows/test.yml "name: test
on: push
permissions: {}
x-jobs: &all
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${C}
jobs:
  <<: *all"
expect_fail merge-jobs "YAML merge keys are not supported"

write_file omap-step .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - !!omap [uses: acme/tool@main]"
expect_fail omap-step "is not a plain mapping"

# An anchored pin and its alias are read from the anchor's line.
write_file anchor-ok .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  a:
    runs-on: ubuntu-latest
    steps:
      - uses: &tool acme/tool@${A} # v1.2.0
  b:
    runs-on: ubuntu-latest
    steps:
      - uses: *tool"
expect_pass anchor-ok

write_file anchor-stale .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  a:
    runs-on: ubuntu-latest
    steps:
      - uses: &tool acme/tool@${A} # v1.3.0
  b:
    runs-on: ubuntu-latest
    steps:
      - uses: *tool"
expect_fail anchor-stale "tag v1.3.0 of acme/tool"

# The comment is read from the line YAML puts the uses on, so a look-alike
# line in a run block can neither satisfy the check nor break it.
write_file decoy .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - run: |
          uses: acme/tool@${A} # v1.2.0
      - \"uses\": acme/tool@${A} # v1.3.0"
expect_fail decoy "cannot read the version comment of acme/tool@${A}"

write_file run-block-noise .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${A} # v1.2.0
      - run: |
          cat <<'YAML'
          - uses: acme/tool@${A}
          YAML"
expect_pass run-block-noise

write_file flow-style .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - {uses: acme/tool@${A}} # v1.2.0"
expect_fail flow-style "cannot read the version comment of acme/tool@${A}"

# --- reusable-workflow permissions
contents_response acme/wf .github/workflows/lint.yml "${A}" 'on: workflow_call
permissions:
  contents: read
  actions: read
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - run: true'

# reusable_workflow FIXTURE WORKFLOW-PERMISSIONS JOB-PERMISSIONS USES [TRIGGER]
reusable_workflow() {
  write_file "$1" .github/workflows/test.yml "name: test
on: ${5:-pull_request}
$2
jobs:
  lint:
$3
    uses: $4"
}

lint_pin="acme/wf/.github/workflows/lint.yml@${A} # v1.2.0"
lint_ref="acme/wf/.github/workflows/lint.yml@${A}"

reusable_workflow job-level-stale '' '    permissions:
      contents: read
      actions: read' "acme/wf/.github/workflows/lint.yml@${A} # v1.3.0"
expect_fail job-level-stale "tag v1.3.0 of acme/wf is at 222222222222, not 111111111111"

reusable_workflow job-level-no-comment '' '    permissions:
      contents: read
      actions: read' "acme/wf/.github/workflows/lint.yml@${A}"
expect_fail job-level-no-comment "acme/wf@${A} has no version comment"

reusable_workflow job-level-tag-pin '' '    permissions: {}' "acme/wf/.github/workflows/lint.yml@v1"
expect_fail job-level-tag-pin "acme/wf/.github/workflows/lint.yml@v1 is not pinned to a full commit SHA"

reusable_workflow elevation '' '    permissions:
      contents: read' "${lint_pin}"
expect_fail elevation "job 'lint' grants actions: none, but ${lint_ref} asks for actions: read"

reusable_workflow fit '' '    permissions:
      contents: read
      actions: read' "${lint_pin}"
expect_pass fit

reusable_workflow workflow-level 'permissions:
  contents: read
  actions: read' '' "${lint_pin}"
expect_pass workflow-level

reusable_workflow job-overrides-workflow 'permissions: write-all' '    permissions:
      contents: read' "${lint_pin}"
