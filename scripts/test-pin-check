# A name from YAML cannot start a workflow command of its own.
contents_response acme/wf .github/workflows/forge.yml "${B}" 'on: workflow_call
jobs:
  "x\n::warning file=README.md,line=1::looks fine":
    permissions:
      contents: bogus
    runs-on: ubuntu-latest
    steps:
      - run: true'
reusable_workflow forged-annotation '' '    permissions: {}' "acme/wf/.github/workflows/forge.yml@${B} # v1.3.0"
expect_fail forged-annotation "unknown permission level 'bogus'"

# Text from a lookup can carry line breaks; none of it may start a command.
printf 'remote: 50%%\r::warning::cr\nremote: x\n::warning file=README.md,line=1::looks fine\nfatal: not found\n' \
  > "${FAKE_GIT_DIR}/acme/noisy.stderr"
step_workflow noisy-lookup "acme/noisy@${A} # v1.2.0"
# Python reads the stand-in's stderr in text mode, so its CR arrives as LF.
expect_fail noisy-lookup "listing the tags of acme/noisy failed: remote: 50%25%0A::warning::cr%0Aremote: x%0A::warning file=README.md"

# A file name is an annotation property: commas and colons are escaped.
write_file property-escape '.github/workflows/a,line=1:b.yml' "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${C} # v1.2.0"
expect_fail property-escape "::error file=.github/workflows/a%2Cline=1%3Ab.yml,line=8,title=pin-check::"

step_workflow unexpected-failure "acme/tool@${A} # v1.2.0"
expect_fail unexpected-failure "unexpected failure: ValueError" 'PIN_CHECK_COLLECTED=x
##[warning]looks fine'

step_workflow partial-check "acme/tool@${A} # v1.2.0"
expect_fail partial-check "collected 2 file(s) but checked 1" PIN_CHECK_COLLECTED=2

# --- the full-SHA step: zizmor's offline unpinned-uses, run from the workflow
# run_full_sha FIXTURE: 0 when the step passes
run_full_sha() {
  mkdir -p "${work}/runner-$1"
  local status=0
  AUDIT_TARGET="${work}/fixtures/$1" AUDIT_TARGET_EMPTY=false RUNNER_TEMP="${work}/runner-$1" \
    bash --noprofile --norc -eo pipefail "${work}/full-sha.sh" > "${work}/$1.full-sha.out" 2>&1 || status=$?
  no_forged_commands "${work}/$1.full-sha.out"
  return "${status}"
}
step_workflow checkout-tag "actions/checkout@v4"
reusable_workflow wf-tag-pin '' '' "acme/wf/.github/workflows/lint.yml@v1"
write_file composite-tag actions/lint/action.yml 'name: lint
description: fixture
runs:
  using: composite
  steps:
    - uses: acme/tool@v1'
for fixture in tag-pin checkout-tag wf-tag-pin composite-tag; do
  if run_full_sha "${fixture}"; then
    fail "${fixture}: the full-SHA step passed a tag pin"
  elif ! grep -Fq 'title=pin-check unpinned::action is not pinned to a hash' "${work}/${fixture}.full-sha.out" \
      || ! grep -Fxq 'Found 1 unpinned reference(s).' "${work}/${fixture}.full-sha.out"; then
    fail "${fixture}: the full-SHA step failed without reporting the unpinned uses"
    sed 's/^/    /' "${work}/${fixture}.full-sha.out" >&2
  fi
done
grep -Fq '::error file=.github/workflows/test.yml,line=8,title=pin-check unpinned::' "${work}/tag-pin.full-sha.out" \
  || fail "tag-pin: the full-SHA annotation does not name the file relative to the repository"
write_file full-sha-escape '.github/workflows/a,line=1:b.yml' "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@v1"
if run_full_sha full-sha-escape; then
  fail "full-sha-escape: the full-SHA step passed a tag pin"
elif ! grep -Fq '::error file=.github/workflows/a%2Cline=1%3Ab.yml,line=8,title=pin-check unpinned::' "${work}/full-sha-escape.full-sha.out"; then
  fail "full-sha-escape: the file property is not escaped"
  sed 's/^/    /' "${work}/full-sha-escape.full-sha.out" >&2
fi
write_file zizmor-quotes-expression .github/workflows/test.yml "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    if: |
      \${{ (
      ::notice title=pin-check::Every pin matches its tag.
      ##[warning file=README.md;line=1]looks fine
      }}
    steps:
      - uses: acme/tool@${A} # v1.2.0"
write_file zizmor-quotes-name '.github/workflows/a##[warning]b.yml' "name: test
on: push
permissions: {}
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: acme/tool@${A} # v1.2.0"
write_file zizmor-fails .github/workflows/test.yml "name: test
on: push
jobs:
  test:
    runs-on: ['
::warning file=README.md,line=1::looks fine
##[warning file=README.md;line=1]looks fine"
if run_full_sha zizmor-fails; then
  fail "zizmor-fails: the full-SHA step passed a file zizmor could not read"
elif ! grep -Eq '^::stop-commands::[0-9a-f]{32}$' "${work}/zizmor-fails.full-sha.out"; then
  fail "zizmor-fails: zizmor's log was not fenced off"
fi
step_workflow docker-untagged "docker://alpine"
if run_full_sha docker-untagged; then
  fail "docker-untagged: the full-SHA step passed an image with no tag"
elif ! grep -Fq 'Pin the image to a tag or a sha256 digest.' "${work}/docker-untagged.full-sha.out"; then
  fail "docker-untagged: the advice does not fit an image"
fi
if run_full_sha lf-name; then
  fail "lf-name: the full-SHA step passed a tag pin"
elif ! grep -Fq '::error file=.github/workflows/a%0Ab.yml,line=8,title=pin-check unpinned::' "${work}/lf-name.full-sha.out"; then
  fail "lf-name: the file property's line break is not escaped"
fi
for fixture in exact fit local-callee composite zizmor-quotes-expression zizmor-quotes-name; do
  if ! run_full_sha "${fixture}"; then
    fail "${fixture}: the full-SHA step failed a SHA or local pin"
    sed 's/^/    /' "${work}/${fixture}.full-sha.out" >&2
  fi
done

# --- the PR-mode collection step, against the stand-in API
api_file() {  # api_file PATH: one entry of the pull request's file list
  printf '{"status":"modified","filename":"%s","contents_url":"https://api.github.com/repos/acme/repo/contents/%s?ref=%s"}' "$1" "$1" "${H}"
}
